<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-references-tools</artifactId>
	<packaging>war</packaging>
	<parent>
		<groupId>jp.ecuacion.references</groupId>
		<artifactId>ecuacion-references-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<properties>
		<!-- Kept up to date automatically by "mvn versions:update-properties" (see
		     build-moduled-project.sh's -Dincludes=...,jp.ecuacion.tool) during release builds,
		     same mechanism used for ecuacion-lib.version / ecuacion-util.version / etc. -->
		<ecuacion-tool.version>0.0.1-SNAPSHOT</ecuacion-tool.version>
	</properties>

	<build>
		<resources>
			<resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
			<resource>
				<directory>src/envs/${mvn.prof-id}/resources</directory>
				<includes><include>**/*.*</include></includes>
			</resource>
			<resource>
				<directory>src/main/java</directory>
				<excludes><exclude>**/*.java</exclude></excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
		</testResources>
	</build>

	<dependencies>

		<!-- spring boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- ecuacion-splib -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-web</artifactId>
		</dependency>

		<!-- markdown article rendering, language switching -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-web-markdown</artifactId>
		</dependency>

		<!-- ecuacion-tool: only to read version_ecuacion-tools.properties for the navbar
			version badge. ecuacion-tools has no single product-wide version, so
			housekeep-common's own version stands in for it.
			ecuacion-splib-batch is excluded: its spring-boot-starter-batch dependency
			pulls in spring-boot-jdbc, which triggers Spring Boot's DataSourceAutoConfiguration
			even though this module has no datasource configured, causing a deploy-time
			BeanCreationException ("Failed to determine a suitable driver class").
			spring-boot-starter-mail / ecuacion-util-excel-table (and its poi / poi-ooxml
			transitive dependencies) / ecuacion-lib-validation-business-messages are excluded
			since they're unused here and would otherwise end up in the war. -->
		<dependency>
			<groupId>jp.ecuacion.tool</groupId>
			<artifactId>ecuacion-tool-housekeep-common</artifactId>
			<version>${ecuacion-tool.version}</version>
			<exclusions>
				<exclusion>
					<groupId>jp.ecuacion.splib</groupId>
					<artifactId>ecuacion-splib-batch</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-mail</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jp.ecuacion.util</groupId>
					<artifactId>ecuacion-util-excel-table</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jp.ecuacion.lib</groupId>
					<artifactId>ecuacion-lib-validation-business-messages</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ecuacion-references -->
		<dependency>
			<groupId>jp.ecuacion.references</groupId>
			<artifactId>ecuacion-references-internal-utils</artifactId>
		</dependency>

	</dependencies>
</project>
