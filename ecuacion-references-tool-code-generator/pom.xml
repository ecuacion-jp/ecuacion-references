<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-references-tool-code-generator</artifactId>
	<packaging>war</packaging>
	<parent>
		<groupId>jp.ecuacion.references</groupId>
		<artifactId>ecuacion-references-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<properties>
		<!-- Kept up to date automatically by "mvn versions:update-properties" (see
		     build-moduled-project.sh's -Dincludes=...,jp.ecuacion.tool.ecuacion-tool-code-generator)
		     during release builds, same mechanism used for ecuacion-lib.version / etc. -->
		<ecuacion-tool-code-generator.version>0.0.1-SNAPSHOT</ecuacion-tool-code-generator.version>
	</properties>

	<build>
		<resources>
			<resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
			<resource>
				<directory>src/main/java</directory>
				<excludes><exclude>**/*.java</exclude></excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
		</testResources>
	</build>

	<dependencies>

		<!-- spring boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- ecuacion-splib -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-web</artifactId>
		</dependency>
		<!-- markdown article rendering, language switching -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-web-markdown</artifactId>
		</dependency>

		<!-- ecuacion-tool-code-generator: only to read
			version_ecuacion-tool-code-generator.properties for the navbar version badge.
			spring-boot-starter-mail / ecuacion-lib-validation-business-messages /
			ecuacion-util-excel-table (and its poi / poi-ooxml transitive dependencies) /
			commons-io are excluded since they're unused here and would otherwise end up
			in the war. ecuacion-splib-core is kept unexcluded since ecuacion-splib-web
			already brings it in. -->
		<dependency>
			<groupId>jp.ecuacion.tool.ecuacion-tool-code-generator</groupId>
			<artifactId>ecuacion-tool-code-generator-core</artifactId>
			<version>${ecuacion-tool-code-generator.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-mail</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jp.ecuacion.lib</groupId>
					<artifactId>ecuacion-lib-validation-business-messages</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jp.ecuacion.util</groupId>
					<artifactId>ecuacion-util-excel-table</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-io</groupId>
					<artifactId>commons-io</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ecuacion-references -->
		<dependency>
			<groupId>jp.ecuacion.references</groupId>
			<artifactId>ecuacion-references-core-for-markdown-only-apps</artifactId>
		</dependency>

	</dependencies>
</project>
